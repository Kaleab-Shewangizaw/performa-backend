# ---- Production environment for cPanel (single-app deploy) ----
# Copy this to `.env` on the server and fill in the PostgreSQL credentials.
# The two JWT secrets below were generated fresh for this deploy — keep them
# secret; regenerate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production

# Leave PORT unset in cPanel — Passenger assigns it automatically.
# PORT=3000

# cPanel PostgreSQL: create the DB + user in "PostgreSQL Databases", then use
# the prefixed names it gives you (host is localhost, default port 5432).
#   postgres://<cpuser>_<dbuser>:<password>@localhost:5432/<cpuser>_<dbname>
# cPanel's Postgres requires SSL for TCP but uses a self-signed cert, so the
# ?sslmode=no-verify suffix (or DB_SSL=true below) is needed.
DATABASE_URL=postgres://shrubsma_app:CHANGE_ME@localhost:5432/shrubsma_proforma?sslmode=no-verify
DB_SSL=true

JWT_ACCESS_SECRET=c653f0f6f50dbaab00255c5bddf71f8f9aacef2e392226e0c5e7d80ab757524b72f70d289c2342ab23e763e5014c5030
JWT_REFRESH_SECRET=365486139d0daac42db2b84e3e919dc29a6656b8e3892108f282a2906bb977339b56cb7364f1d6ea0c3ffa0456407c59
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# The backend serves the built frontend from ./public — no change needed.
# CLIENT_DIR=public

# Only set this if you deploy the frontend on a DIFFERENT domain than the API.
# For the single-app deploy (recommended) leave it empty.
# CORS_ORIGIN=https://proforma.shrubsmarble.com
