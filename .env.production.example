# ---- Production environment for cPanel (single-app deploy, MySQL) ----
# Copy to `.env` on the server and fill in the MySQL credentials.

NODE_ENV=production

# Leave PORT unset — Passenger assigns it.
# PORT=3000

# cPanel MySQL: create the DB + user in "MySQL Databases", grant ALL PRIVILEGES,
# then use the prefixed names it gives you. cPanel grants are @'localhost'
# (socket), so DB_SOCKET_PATH is set below to match.
DATABASE_URL=mysql://shrubsma_app:CHANGE_ME@localhost/shrubsma_proforma
DB_SOCKET_PATH=/var/lib/mysql/mysql.sock

# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# The backend serves the built frontend from ./public — no change needed.
# Prevents a CloudLinux WASM/memory crash in Node's built-in fetch (unused).
NODE_OPTIONS=--no-experimental-fetch
