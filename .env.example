NODE_ENV=development
PORT=3000

# MySQL / MariaDB connection string
DATABASE_URL=mysql://performa:performa_dev_pw@127.0.0.1:3307/performa
# On cPanel set this to the MySQL socket (matches @'localhost' grants):
# DB_SOCKET_PATH=/var/lib/mysql/mysql.sock

# JWT secrets - generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
